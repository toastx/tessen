# Stage 1: Build
FROM rustlang/rust:nightly-slim AS builder

WORKDIR /app

# Solana and crypto crates require native build tooling.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libssl-dev \
    libudev-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY . .

RUN cargo build --locked --release --manifest-path keeper/Cargo.toml

# Stage 2: Runtime
FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/keeper/target/release/tessen-keeper /usr/local/bin/server

CMD ["server"]
