# Stage 1: Build
FROM rustlang/rust:nightly-slim AS builder

WORKDIR /app

# Solana and crypto crates require native build tooling.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libssl-dev \
    libudev-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY . .

RUN cargo build --locked --release --manifest-path backend/Cargo.toml

# Stage 2: Runtime
FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/backend/target/release/tessen-backend /usr/local/bin/server

ENV DB_PATH=/data/tessen.db
RUN mkdir -p /data

EXPOSE 8080
VOLUME ["/data"]

CMD ["server"]
